# Przykładowa konfiguracja aplikacji linkbox.
#
# Aplikacja NIE czyta tego pliku sama. Czyta zmienne środowiskowe procesu,
# a ten plik jest wygodnym miejscem, żeby je trzymać — trzeba go tylko
# wczytać do środowiska przed uruchomieniem (patrz niżej: `set -a`).
#
# Skopiuj go na .env i tam wpisuj swoje wartości. Zmiany w kopii DZIAŁAJĄ —
# pod warunkiem, że wczytasz ją do środowiska i uruchomisz aplikację od nowa.
#
# Dlaczego konfiguracja jest w zmiennych środowiskowych, a nie w kodzie?
# Bo ta sama aplikacja ma działać na Twoim komputerze i na serwerze,
# różniąc się wyłącznie ustawieniami. Gdyby adres bazy albo hasło siedziały
# w kodzie, każda zmiana środowiska oznaczałaby zmianę kodu — a hasło
# wpisane w kodzie trafia do repozytorium i zostaje tam na zawsze.
#
# Jak z tego skorzystać w powłoce bash:
#
#   cp .env.example .env      # kopia robocza (plik .env NIE trafia do repozytorium)
#   set -a; source .env; set +a
#   python -m app
#
# `set -a` sprawia, że każda kolejna przypisana zmienna staje się zmienną
# środowiskową (jest eksportowana). `set +a` wyłącza to zachowanie z powrotem.
#
# Sprawdzenie, co aplikacja faktycznie zobaczyła: pierwsze linie jej logu
# przy starcie wypisują komplet ustawień.


# Adres, na którym aplikacja nasłuchuje.
# 127.0.0.1 oznacza "tylko ta maszyna" — z innego komputera aplikacja
# będzie wtedy niewidoczna, nawet jeśli port jest otwarty.
APP_HOST=127.0.0.1

# Port TCP, na którym aplikacja nasłuchuje.
# Porty poniżej 1024 wymagają uprawnień administratora.
APP_PORT=8000

# Adres bazy danych w formacie SQLAlchemy.
# sqlite:///./links.db  → plik links.db w katalogu, z którego uruchomiono aplikację.
# Trzy ukośniki to ścieżka względna, cztery — bezwzględna (sqlite:////var/lib/links.db).
DATABASE_URL=sqlite:///./links.db

# Lista adresów (origin-ów), którym przeglądarka pozwoli czytać odpowiedzi
# tego API, rozdzielona przecinkami.
#
# PUSTA WARTOŚĆ = brak nagłówków CORS = przeglądarka zablokuje front
# działający na innym porcie. To nie jest usterka, tylko ustawienie domyślne:
# API domyślnie nie ufa nikomu i trzeba mu wskazać, komu ma zaufać.
#
# Origin to schemat + host + port, bez ścieżki na końcu:
#   http://localhost:3000        poprawnie
#   http://localhost:3000/       niepoprawnie (ukośnik na końcu)
#   localhost:3000               niepoprawnie (brak schematu)
#
# Przykład dla frontu uruchomionego na porcie 3000:
#   CORS_ORIGINS=http://localhost:3000
# Przykład dla dwóch frontów naraz:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=

# Ilość szczegółów w logach: CRITICAL, ERROR, WARNING, INFO, DEBUG.
# DEBUG przy szukaniu przyczyny problemu, INFO na co dzień.
LOG_LEVEL=INFO

# Nazwa instancji aplikacji. Trafia do każdej linii logu i do etykiety
# w metrykach. Przy dwóch uruchomionych kopiach aplikacji to jedyne,
# co pozwala odróżnić, która z nich odpowiedziała.
APP_NAME=linkbox
